rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['firstName', 'lastName'])
        && data.firstName is string && data.firstName.size() <= 100
        && data.lastName is string && data.lastName.size() <= 100
        && data.get('title', '') is string
        && data.get('role', '') is string
        && data.get('institution', '') is string;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId)
                    && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId)
                    && isValidUserProfile(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'title', 'role', 'institution']);
    }

    match /users/{userId}/settings/preferences {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId)
                    && incoming().get('autoSync', false) is bool
                    && incoming().get('autoSyncMobile', false) is bool
                    && incoming().get('gpsTracking', false) is bool
                    && incoming().get('offlineImageCompression', false) is bool
                    && incoming().get('scientificNameSuggestions', false) is bool
                    && incoming().get('highAccuracyMode', false) is bool
                    && incoming().get('backgroundTracking', false) is bool
                    && incoming().get('coordinateFormat', 'DD') is string
                    && incoming().get('coordinateFormat', 'DD').size() <= 10;
    }

    function isValidSurveySession(data) {
      return data.keys().hasAll(['userId', 'projectName', 'siteName', 'ecosystemType', 'researcherName', 'date', 'status', 'numQuadrats'])
        && data.userId is string && data.userId == request.auth.uid
        && data.projectName is string && data.projectName.size() <= 200
        && data.siteName is string && data.siteName.size() <= 200
        && data.ecosystemType is string && data.ecosystemType.size() <= 100
        && data.researcherName is string && data.researcherName.size() <= 100
        && data.date is string && data.date.size() <= 100
        && data.status is string && data.status.size() <= 20
        && data.numQuadrats is number
        && data.get('vegetationType', '') is string
        && data.get('sampleSite', '') is string
        && data.get('quadratSize', '') is string
        && data.get('transectLength', 0) is number
        && data.get('samplingInterval', 0) is number
        && data.get('samplingMethod', '') is string
        && data.get('lat', 0.0) is number
        && data.get('lng', 0.0) is number;
    }

    match /surveys/{surveyId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(surveyId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(surveyId) && isValidSurveySession(incoming());
      
      allow update: if isSignedIn() && isValidId(surveyId) && existing().userId == request.auth.uid
                    && isValidSurveySession(incoming())
                    && incoming().userId == existing().userId
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                      'projectName', 'siteName', 'ecosystemType', 'researcherName', 'date', 'status',
                      'numQuadrats', 'vegetationType', 'sampleSite', 'quadratSize', 'transectLength',
                      'samplingInterval', 'samplingMethod', 'lat', 'lng'
                    ]);
                    
      allow delete: if isSignedIn() && isValidId(surveyId) && existing().userId == request.auth.uid;
    }

    function isValidSpeciesRecord(data) {
      return data.keys().hasAll(['name', 'family', 'quadrats'])
        && data.name is string && data.name.size() <= 200
        && data.family is string && data.family.size() <= 200
        && data.quadrats is list && data.quadrats.size() <= 1000
        && (data.quadrats.size() == 0 || data.quadrats[0] is number)
        && data.get('localName', '') is string
        && data.get('notes', '') is string
        && data.get('stratum', '') is string;
    }

    match /surveys/{surveyId}/species/{speciesId} {
      // Must verify parent document ownership since this is a subcollection
      function isSurveyOwner() {
        return get(/databases/$(database)/documents/surveys/$(surveyId)).data.userId == request.auth.uid;
      }

      allow get: if isSignedIn() && isSurveyOwner() && isValidId(surveyId) && isValidId(speciesId);
      allow list: if isSignedIn() && isSurveyOwner() && isValidId(surveyId);
      
      allow create: if isSignedIn() && isValidId(surveyId) && isValidId(speciesId) 
                    && isSurveyOwner() && isValidSpeciesRecord(incoming());
                    
      allow update: if isSignedIn() && isValidId(surveyId) && isValidId(speciesId) 
                    && isSurveyOwner() && isValidSpeciesRecord(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                      'name', 'family', 'quadrats', 'localName', 'notes', 'stratum'
                    ]);
                    
      allow delete: if isSignedIn() && isValidId(surveyId) && isValidId(speciesId) 
                    && isSurveyOwner();
    }
  }
}
